# TrustRail environment configuration.
# Contains variable NAMES and SAFE LOCAL PLACEHOLDERS ONLY.
# Never commit real secrets or key material. Copy to .env (.env is gitignored).

# ---- Core (Milestone 1) ----
TRUSTRAIL_ENV=local
TRUSTRAIL_LOG_LEVEL=INFO

# ---- Database (Milestone 2) ----
# Async driver DSN. The password below is a LOCAL-ONLY placeholder, not a secret.
DATABASE_URL=postgresql+asyncpg://trustrail:trustrail@localhost:5432/trustrail
# Logically separate database used by the test suite.
TEST_DATABASE_URL=postgresql+asyncpg://trustrail:trustrail@localhost:5432/trustrail_test
# Set to true to echo SQL for local debugging (never logs credentials).
TRUSTRAIL_DB_ECHO=false

# ---- PostgreSQL container credentials (Docker Compose, local dev only) ----
POSTGRES_USER=trustrail
POSTGRES_PASSWORD=trustrail
POSTGRES_DB=trustrail

# ---- OPA (Milestone 3) ----
OPA_URL=

# ---- API key verifier pepper (Milestone 5) ----
# Server-side secret used to derive API key verifiers. Keep empty here.
API_KEY_PEPPER=

# ---- Ed25519 signing key (Milestone 14) ----
# Never commit key material. Path/ID are declared here for contract visibility only.
SIGNING_KEY_ID=
SIGNING_KEY_PATH=
